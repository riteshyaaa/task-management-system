# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Configuration (PostgreSQL)
# Provide your own local PostgreSQL connection string OR obtain a free cloud PostgreSQL database from https://neon.tech
# Option 1: Local PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/task_management?schema=public"

# Option 2: Cloud PostgreSQL (Neon Serverless Postgres)
# DATABASE_URL="postgresql://<username>:<password>@<neon-host>.neon.tech/neondb?sslmode=require"

# JWT Authentication Secrets (Use 32+ character random strings)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Reset Token Expiry (minutes)
PASSWORD_RESET_EXPIRES_MINUTES=60

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX_REQUESTS=10000

# Logging
LOG_LEVEL=debug
